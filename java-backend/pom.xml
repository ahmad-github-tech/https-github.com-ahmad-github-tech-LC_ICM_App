<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.tradefinance</groupId>
    <artifactId>meridian-lc-casemanager-services</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>Meridian LC Case Manager Services</name>
    <description>Spring Boot 3.2.5 WAR backend services for Letter of Credit Case Manager (IBM ICM + MySQL Custom DB)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Provided Tomcat for standalone .war deployment while still runnable in STS -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MySQL Driver with JPA auto table generation -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
        IBM FileNet Content Engine & Process Engine / ICM Case API JARs:
        Place Jace.jar, pe.jar, peResources.jar, and icm-case-api.jar into java-backend/libs/
        and uncomment these dependencies:
        <dependency>
            <groupId>com.ibm.filenet</groupId>
            <artifactId>Jace</artifactId>
            <version>5.5.x</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/Jace.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.ibm.filenet</groupId>
            <artifactId>pe</artifactId>
            <version>5.5.x</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/pe.jar</systemPath>
        </dependency>
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>meridian-lc-casemanager-services</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
